<?xml version="1.0"?>

<compsets>

  <help>
  Compset format is explained in cime/config/e3sm/allactive/config_compsets.xml
  or in the CIME documenation
  </help>

  <!---EOCN compsets -->

  <!-- Prognostic EAM over the emulated ocean, everything else stubbed.
       Note the coupler sets the atmosphere's land fraction to 1 - ocean
       fraction (seq_frac_mct.F90:514), so with a stub land the merge hands
       EAM a surface state weighted only by the ocean's share of each cell and
       nothing over the continents.  Use F2010-ELM-EOCN unless that is exactly
       what is being tested. -->
  <compset>
    <alias>F2010-EOCN</alias>
    <lname>2010_EAM%CMIP6_SLND_SICE_EOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- the same, with a land model so the continents have a surface -->
  <compset>
    <alias>F2010-ELM-EOCN</alias>
    <lname>2010_EAM%CMIP6_ELM%SPBC_SICE_EOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- both halves of SamudrACE, coupled through MCT; everything else stubbed.
       With a stub ice the coupler has nowhere to put the sea ice fraction
       Samudra predicts, so it reports the polar ocean as open water all year.
       Prefer E2000-EATM-EOCN-EICE; keep this one to measure what the ice is
       worth. -->
  <compset>
    <alias>E2000-EATM-EOCN</alias>
    <lname>2000_EATM_SLND_SICE_EOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- the same pair, with the ocean emulator's own sea ice fraction carried
       into the coupler's fraction bookkeeping by EICE -->
  <compset>
    <alias>E2000-EATM-EOCN-EICE</alias>
    <lname>2000_EATM_SLND_EICE_EOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- prognostic EAM over the emulated ocean and its ice.  EAM needs a real
       ice surface at the poles; F2010-ELM-EOCN has none and fails in the
       microphysics on the first step. -->
  <compset>
    <alias>F2010-ELM-EOCN-EICE</alias>
    <lname>2010_EAM%CMIP6_ELM%SPBC_EICE_EOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- EAMxx (SCREAM) over the emulated ocean and its ice.  EAMxx is the
       GPU-ready atmosphere, so this is the prognostic-atmosphere configuration
       to prefer on pm-gpu; F2010-ELM-EOCN-EICE is the EAM equivalent. -->
  <compset>
    <alias>FSCREAM-EOCN-EICE</alias>
    <lname>2010_SCREAM_ELM%SPBC_EICE_EOCN_SROF_SGLC_SWAV_SIAC_SESP</lname>
  </compset>

</compsets>
