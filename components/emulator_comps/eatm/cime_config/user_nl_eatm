! NOTE: if the xml variable ATM_GRID is set to 'null' then EATM_MODE is NULL and
!       build-namelist sets do_eatm = .false.
!
! Commonly overridden settings:
!
!   eatm_model_file     = '/path/to/traced_model_cuda.pt'
!   eatm_ic_file        = '/path/to/emulator_initial_condition.nc'
!   eatm_model_device   = 'gpu'      ! or 'cpu'; must match how the model was traced
!   eatm_legacy_surface = .false.    ! .true. restores the pre-review surface diagnostics
