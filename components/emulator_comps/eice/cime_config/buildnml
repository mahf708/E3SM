#!/usr/bin/env python3

"""
EICE has no namelist of its own.  It takes its grid and its ice fraction from
the ocean emulator at run time, and every other number it reports is a
compile-time constant shared with dice.  This exists because CIME requires a
buildnml per component, not because there is anything to configure.
"""

import os, sys

_CIMEROOT = os.environ.get("CIMEROOT")
if _CIMEROOT is None:
    raise SystemExit("ERROR: must set CIMEROOT environment variable")

sys.path.append(os.path.join(_CIMEROOT, "scripts", "Tools"))

from standard_script_setup import *
from CIME.case import Case
from CIME.buildnml import create_namelist_infile, parse_input

logger = logging.getLogger(__name__)


def buildnml(case, caseroot, compname):
    rundir = case.get_value("RUNDIR")
    # A stub file so anything that looks for ice_in finds one.
    with open(os.path.join(rundir, "ice_in"), "w") as fd:
        fd.write("&eice_inparm\n/\n")


def _main_func():
    caseroot = parse_input(sys.argv)
    with Case(caseroot) as case:
        buildnml(case, caseroot, "eice")


if __name__ == "__main__":
    _main_func()
