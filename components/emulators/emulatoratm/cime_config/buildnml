#!/usr/bin/env python3

"""Write atm_in for the emulated atmosphere."""

import os
import sys

_CIMEROOT = os.environ.get("CIMEROOT")
if _CIMEROOT is None:
    raise SystemExit("ERROR: CIMEROOT not defined.")
sys.path.append(os.path.join(_CIMEROOT, "scripts", "Tools"))
sys.path.append(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "..", "..", "cime_config"))

from standard_script_setup import *  # noqa: F401,F403,E402
from CIME.buildnml import parse_input  # noqa: E402
from CIME.case import Case  # noqa: E402
from emulator_settings import spec_path, write_input_file  # noqa: E402


def buildnml(case, caseroot, compname):
    if compname != "emulatoratm":
        raise AttributeError("expected emulatoratm, got " + compname)
    settings = {
        "spec": spec_path(case, case.get_value("EMULATORATM_SPEC")),
        "coupler_dt": 86400 // case.get_value("ATM_NCPL"),
        "grid": {"file": case.get_value("EMULATORATM_GRID_FILE"),
                 "domain": "full"},
        "initial_condition": case.get_value("EMULATORATM_IC_FILE"),
        "inference": {"backend": "libtorch",
                      "model_path": case.get_value("EMULATORATM_MODEL_FILE"),
                      "device": case.get_value("EMULATORATM_DEVICE")},
    }
    write_input_file(case, caseroot, compname, "atm", settings)


def _main_func():
    caseroot = parse_input(sys.argv)
    with Case(caseroot) as case:
        buildnml(case, caseroot, "emulatoratm")


if __name__ == "__main__":
    _main_func()
