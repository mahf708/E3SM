<?xml version="1.0"?>

<definitions_variables>

  <entry id="COMP_ATM">
     <type>char</type>
     <valid_values>emulatoratm</valid_values>
     <default_value>emulatoratm</default_value>
     <group>case_comp</group>
     <file>env_case.xml</file>
     <desc>Name of atm component</desc>
  </entry>

  <entry id="EMULATORATM_MODE">
    <type>char</type>
    <valid_values>ACTIVE,NULL</valid_values>
    <default_value>ACTIVE</default_value>
    <values>
      <value compset="_EMULATORATM.*">ACTIVE</value>
      <value grid="a%null">NULL</value>
    </values>
    <group>build_component_emulatoratm</group>
    <file>env_build.xml</file>
    <desc>mode for emulatoratm model, NULL means emulatoratm is turned off</desc>
  </entry>

  <entry id="EMULATORATM_GRID_FILE">
    <type>char</type>
    <default_value>/pscratch/sd/m/mahf708/eocn-inputdata/share/meshes/gaussian_180x360_latlon_grnwst.scrip.20260913.nc</default_value>
    <group>run_component_emulatoratm</group>
    <file>env_run.xml</file>
    <desc>SCRIP grid the atmosphere emulator runs on (atm_in grid_file)</desc>
  </entry>

  <entry id="EMULATORATM_SPEC">
    <type>char</type>
    <default_value>ace2-eamv3.yaml</default_value>
    <values>
      <!-- fme's ocean-to-atmosphere exchange: with the energy-corrected trace,
           SST RMSE against fme's ref1yr at day 355 is 1.38 K, against 2.05 K
           for the coupler-surface spec and the uncorrected trace (2 seeds). -->
      <value compset="_EMULATOROCN">samudrace-e3smv3-atmosphere-fme-surface.yaml</value>
    </values>
    <group>run_component_emulatoratm</group>
    <file>env_run.xml</file>
    <desc>Spec in components/emulators/specs describing the atmosphere emulator</desc>
  </entry>

  <entry id="EMULATORATM_MODEL_FILE">
    <type>char</type>
    <default_value>/global/cfs/cdirs/e3sm/anolan/ACE2-E3SMv3/ace_traced_cuda.pt</default_value>
    <values>
      <!-- traced with fme's total energy budget correction (trace.py) -->
      <value compset="_EMULATOROCN">/pscratch/sd/m/mahf708/SamudrACE-E3SMv3/eatm/samudrace_atm_traced_cuda_energy.pt</value>
    </values>
    <group>run_component_emulatoratm</group>
    <file>env_run.xml</file>
    <desc>Traced TorchScript atmosphere (atm_in model_path)</desc>
  </entry>

  <entry id="EMULATORATM_IC_FILE">
    <type>char</type>
    <default_value>/global/cfs/cdirs/e3sm/anolan/ACE2-E3SMv3/initial_conditions/1971010100_time_1.nc</default_value>
    <values>
      <value compset="_EMULATOROCN">/pscratch/sd/m/mahf708/SamudrACE-E3SMv3/eatm/samudrace_atm_ic_0.nc</value>
    </values>
    <group>run_component_emulatoratm</group>
    <file>env_run.xml</file>
    <desc>Atmosphere emulator initial condition (atm_in ic_file)</desc>
  </entry>

  <entry id="EMULATORATM_DEVICE">
    <type>char</type>
    <default_value>cuda</default_value>
    <group>run_component_emulatoratm</group>
    <file>env_run.xml</file>
    <desc>Inference device for the atmosphere emulator: cuda or cpu</desc>
  </entry>

  <description>
    <desc compset="_EMULATORATM">EMULATORATM: machine-learned atmosphere (ACE) on the emulator framework</desc>
  </description>

</definitions_variables>
