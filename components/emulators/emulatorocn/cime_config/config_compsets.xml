<?xml version="1.0"?>

<compsets>

  <help>
  Compset format is explained in cime_config/allactive/config_compsets.xml
  or in the CIME documentation.
  </help>

  <!-- SamudrACE: the ACE atmosphere, the Samudra ocean and its sea ice,
       all emulated, on the 180x360 Gaussian grid. -->
  <compset>
    <alias>EMU2000-SAMUDRACE</alias>
    <lname>2000_EMULATORATM_SLND_EMULATORICE_EMULATOROCN_SROF_SGLC_SWAV</lname>
    <support_level>Experimental, under development</support_level>
  </compset>

  <!-- The Samudra ocean and its sea ice under E3SM's own atmosphere and land:
       the ocean forced by the coupler's merged fluxes. -->
  <compset>
    <alias>F2010-EMU-SAMUDRA</alias>
    <lname>2010_EAM%CMIP6_ELM%SPBC_EMULATORICE_EMULATOROCN_SROF_SGLC_SWAV</lname>
    <support_level>Experimental, under development</support_level>
  </compset>

  <!-- The same under 1850 forcing: SamudrACE-E3SMv3 was trained on E3SMv3's
       preindustrial control, so this is the atmosphere its ocean knows. -->
  <compset>
    <alias>F1850-EMU-SAMUDRA</alias>
    <lname>1850_EAM%CMIP6_ELM%SPBC_EMULATORICE_EMULATOROCN_SROF_SGLC_SWAV</lname>
    <support_level>Experimental, under development</support_level>
  </compset>

</compsets>
