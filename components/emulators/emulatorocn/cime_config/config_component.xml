<?xml version="1.0"?>

<definitions_variables>

  <entry id="COMP_OCN">
     <type>char</type>
     <valid_values>emulatorocn</valid_values>
     <default_value>emulatorocn</default_value>
     <group>case_comp</group>
     <file>env_case.xml</file>
     <desc>Name of ocean component</desc>
  </entry>

  <entry id="EMULATOROCN_GRID_FILE">
    <type>char</type>
    <default_value>$DIN_LOC_ROOT/share/meshes/gaussian_180x360_latlon.scrip.20260127.nc</default_value>
    <group>run_component_emulatorocn</group>
    <file>env_run.xml</file>
    <desc>SCRIP grid the ocean emulator runs on (ocn_in grid_file)</desc>
  </entry>

  <entry id="EMULATOROCN_SPEC">
    <type>char</type>
    <default_value>samudra-e3smv3-ocean-coupler-forced.yaml</default_value>
    <values>
      <value compset="EMULATORATM.*_EMULATOROCN">samudra-e3smv3-ocean.yaml</value>
    </values>
    <group>run_component_emulatorocn</group>
    <file>env_run.xml</file>
    <desc>Spec in components/emulators/specs describing the ocean emulator: SamudrACE's (forced by the emulated atmosphere) or coupler-forced</desc>
  </entry>

  <entry id="EMULATOROCN_MODEL_FILE">
    <type>char</type>
    <default_value>/pscratch/sd/m/mahf708/SamudrACE-E3SMv3/eocn/samudra_ocn_traced_masked_cuda.pt</default_value>
    <group>run_component_emulatorocn</group>
    <file>env_run.xml</file>
    <desc>Traced TorchScript ocean (ocn_in model_path)</desc>
  </entry>

  <entry id="EMULATOROCN_IC_FILE">
    <type>char</type>
    <default_value>/pscratch/sd/m/mahf708/SamudrACE-E3SMv3/eocn/samudra_ocn_ic_0_icemask.nc</default_value>
    <group>run_component_emulatorocn</group>
    <file>env_run.xml</file>
    <desc>Ocean emulator initial condition; its mask_2d is the domain mask (ocn_in ic_file)</desc>
  </entry>

  <entry id="EMULATOROCN_DEVICE">
    <type>char</type>
    <default_value>cuda</default_value>
    <group>run_component_emulatorocn</group>
    <file>env_run.xml</file>
    <desc>Inference device for the ocean emulator: cuda or cpu</desc>
  </entry>

  <description>
    <desc compset="_EMULATOROCN">EMULATOROCN: machine-learned ocean (Samudra) on the emulator framework</desc>
  </description>

</definitions_variables>
