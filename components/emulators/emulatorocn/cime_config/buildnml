#!/usr/bin/env python3

"""Write ocn_in for the emulated ocean."""

import os
import sys

_CIMEROOT = os.environ.get("CIMEROOT")
if _CIMEROOT is None:
    raise SystemExit("ERROR: CIMEROOT not defined.")
sys.path.append(os.path.join(_CIMEROOT, "scripts", "Tools"))
sys.path.append(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "..", "..", "cime_config"))

from standard_script_setup import *  # noqa: F401,F403,E402
from CIME.buildnml import parse_input  # noqa: E402
from CIME.case import Case  # noqa: E402
from CIME.utils import expect  # noqa: E402
from emulator_settings import spec_path, write_input_file  # noqa: E402

def buildnml(case, caseroot, compname):
    if compname != "emulatorocn":
        raise AttributeError("expected emulatorocn, got " + compname)
    expect(case.get_value("OCN_NCPL") == case.get_value("ATM_NCPL"),
           "emulatorocn accumulates its window's forcing every coupler step; "
           "set OCN_NCPL = ATM_NCPL.")
    settings = {
        "spec": spec_path(case, case.get_value("EMULATOROCN_SPEC")),
        "coupler_dt": 86400 // case.get_value("OCN_NCPL"),
        "grid": {"file": case.get_value("EMULATOROCN_GRID_FILE"),
                 "domain": "ocean_mask", "mask_variable": "mask_2d",
                 "publish_as": "ocn"},
        "initial_condition": case.get_value("EMULATOROCN_IC_FILE"),
        "inference": {"backend": "libtorch",
                      "model_path": case.get_value("EMULATOROCN_MODEL_FILE"),
                      "device": case.get_value("EMULATOROCN_DEVICE")},
    }
    write_input_file(case, caseroot, compname, "ocn", settings)


def _main_func():
    caseroot = parse_input(sys.argv)
    with Case(caseroot) as case:
        buildnml(case, caseroot, "emulatorocn")


if __name__ == "__main__":
    _main_func()
