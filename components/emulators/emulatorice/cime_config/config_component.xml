<?xml version="1.0"?>

<definitions_variables>

  <entry id="COMP_ICE">
     <type>char</type>
     <valid_values>emulatorice</valid_values>
     <default_value>emulatorice</default_value>
     <group>case_comp</group>
     <file>env_case.xml</file>
     <desc>Name of sea ice component</desc>
  </entry>

  <entry id="EMULATORICE_SPEC">
    <type>char</type>
    <default_value>samudra-e3smv3-sea-ice-energy-balance.yaml</default_value>
    <values>
      <!-- an emulated atmosphere never reads the ice skin -->
      <value compset="EMULATORATM.*_EMULATORICE">samudrace-e3smv3-sea-ice.yaml</value>
    </values>
    <group>run_component_emulatorice</group>
    <file>env_run.xml</file>
    <desc>Spec in components/emulators/specs describing the sea ice</desc>
  </entry>

  <description>
    <desc compset="_EMULATORICE">EMULATORICE: the emulated ocean's sea ice, reported to the coupler</desc>
  </description>

</definitions_variables>
